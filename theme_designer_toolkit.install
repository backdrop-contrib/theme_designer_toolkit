
<?php
/**
 * @file
 * Install and uninstall functions for Theme Designer Toolkit.
 */

/**
 * Implements hook_uninstall().
 */
function theme_designer_toolkit_uninstall() {
  $directory = 'public://theme_designer_toolkit';

  if (is_dir($directory)) {
    file_unmanaged_delete($directory . '/tools.json');

    // Remove the directory only if it is empty.
    $path = backdrop_realpath($directory);

    if ($path && count(scandir($path)) === 2) {
      backdrop_rmdir($directory);
    }
  }
}
