<?php
/**
 * @file
 * Provides a central interface for theme design and development tools.
 */

/**
 * Implements hook_menu().
 */
function theme_designer_toolkit_menu() {
  $items = array();

  $items['admin/appearance/toolkit'] = array(
    'title' => 'Theme Designer Toolkit',
    'description' => 'Discover and access theme design and development tools.',
    'page callback' => 'theme_designer_toolkit_admin_page',
    'access arguments' => array('access theme designer toolkit'),
    'type' => MENU_NORMAL_ITEM,
    'file' => 'theme_designer_toolkit.admin.inc',
  );

  return $items;
}

/**
 * Implements hook_permission().
 */
function theme_designer_toolkit_permission() {
  return array(
    'access theme designer toolkit' => array(
      'title' => t('Access Theme Designer Toolkit'),
      'description' => t('Access the theme design and development tools interface.'),
    ),
  );
}



/**
 * Loads the available theme design tools.
 */
function theme_designer_toolkit_get_tools() {
  $path = backdrop_get_path('module', 'theme_designer_toolkit');

  $files = array(
    'public://theme_designer_toolkit/tools.json',
    $path . '/tools.json',
  );

  foreach ($files as $file) {
    if (!is_readable($file)) {
      continue;
    }

    $data = json_decode(file_get_contents($file), TRUE);

    if (theme_designer_toolkit_validate_tools($data)) {
      return $data['tools'];
    }
  }

  return array();
}



/**
 * Validates the tools registry structure.
 */
function theme_designer_toolkit_validate_tools($data) {
  if (!is_array($data) ||
      !isset($data['version'], $data['tools']) ||
      $data['version'] !== 1 ||
      !is_array($data['tools'])) {
    return FALSE;
  }

  foreach ($data['tools'] as $module => $tool) {
    if (!is_string($module) ||
        !preg_match('/^[a-z][a-z0-9_]*$/D', $module) ||
        !is_array($tool)) {
      return FALSE;
    }

    foreach (array('name', 'description', 'project', 'path') as $key) {
      if (!isset($tool[$key]) || !is_string($tool[$key])) {
        return FALSE;
      }
    }

    if (!valid_url($tool['project'], TRUE) ||
        strpos($tool['project'], 'https://') !== 0) {
      return FALSE;
    }

    if ($tool['path'] !== '' &&
        !preg_match('#^admin/[a-zA-Z0-9_/-]+$#D', $tool['path'])) {
      return FALSE;
    }
  }

  return TRUE;
}


/**
 * Downloads and updates the tools registry.
 *
 * @return bool
 *   TRUE on success, or FALSE on failure.
 */
function theme_designer_toolkit_update_tools() {
  $url = 'https://raw.githubusercontent.com/shabib-m/theme_designer_toolkit/main/tools.json';

  $response = backdrop_http_request($url, array(
    'timeout' => 10,
    'max_redirects' => 0,
  ));

  // Check the HTTP response.
  if ($response->code != 200 || empty($response->data)) {
    return FALSE;
  }

  // Validate the downloaded JSON.
  $data = json_decode($response->data, TRUE);

  if (!theme_designer_toolkit_validate_tools($data)) {
    return FALSE;
  }

  // Prepare the local directory.
  $directory = 'public://theme_designer_toolkit';

  if (!file_prepare_directory($directory, FILE_CREATE_DIRECTORY | FILE_MODIFY_PERMISSIONS)) {
    return FALSE;
  }

  // Save the validated tools registry.
  $destination = $directory . '/tools.json';

  $file = file_unmanaged_save_data(
    $response->data,
    $destination,
    FILE_EXISTS_REPLACE
  );

  return $file !== FALSE;
}
